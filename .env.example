# gold-mcp environment variables.
#
# Copy this file to .env (kept out of git) and fill in the values that
# apply to your machine. Every variable is optional — tools whose
# inputs are missing will return a structured `not_configured` error,
# leaving the rest of the server functional.
#
# Foundation (live tick + L2 stream)
GOLD_MCP_L2_DIR=
GOLD_MCP_TICKS_DIR=

# Layer 1 — proprietary precomputed data
GOLD_MCP_MACRO_STRENGTH_FILE=
GOLD_MCP_NEWS_CALENDAR_FILE=

# Layer 2 — strategy engine result artifacts
GOLD_MCP_STRATEGY_RESULTS_DIR=

# Layer 1 (future) — aggregated broker consensus
GOLD_MCP_BROKER_CONSENSUS_DIR=

# Layer 2 (future) — VSA radar signals + thresholds
GOLD_MCP_RADAR_SIGNALS_FILE=
