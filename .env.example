# gold-mcp v4.1.0 — environment variables
# All variables are OPTIONAL. Server boots fine with none set (Free tier).

# ============================================================================
# Tier unlock (Pro / Premium / Ultra)
# ============================================================================
# Obtain a license at https://pthaicapital.io.vn/mcp/  (Lemon Squeezy checkout)
# License is verified offline via Ed25519 — no phone-home, no SaaS.
# GOLD_MCP_LICENSE_KEY=

# ============================================================================
# Ultra tier: BYOK AI Analyst (ai_daily_briefing, ai_setup_explanation)
# ============================================================================
# Get an API key at https://console.anthropic.com
# ANTHROPIC_API_KEY=

# ============================================================================
# Ultra tier: HTML/Markdown report output directory
# ============================================================================
# Default: ~/.cache/gold-mcp/reports/
# GOLD_MCP_REPORTS_DIR=

# ============================================================================
# Realtime PAXG tick worker (Free tier, v4.1+)
# ============================================================================
# Default DB path: ~/.cache/gold-mcp/paxg.sqlite
# PAXG_DB_PATH=
# PAXG_WS_URL=wss://stream.binance.com:9443/ws/paxgusdt@trade

# ============================================================================
# Lemon Squeezy webhook (for vendor self-hosting the issuance endpoint)
# ============================================================================
# LEMONSQUEEZY_SIGNING_SECRET=
# LICENSE_PRIVATE_KEY_B64=
# LS_VARIANT_ID_PRO=
# LS_VARIANT_ID_PREMIUM=
# LS_VARIANT_ID_ULTRA=
# SMTP_HOST=
# SMTP_PORT=465
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=noreply@pthaicapital.io.vn
